# Point at your local AzerothCore stack (auth + world + MySQL).
# This repo's local stack often uses trinity:trinity (see worldserver.conf).
E2E_AUTH_ADDR=127.0.0.1:3724
E2E_AUTH_DSN=trinity:trinity@tcp(127.0.0.1:3306)/acore_auth
E2E_CHAR_DSN=trinity:trinity@tcp(127.0.0.1:3306)/acore_characters
E2E_WORLD_DSN=trinity:trinity@tcp(127.0.0.1:3306)/acore_world

# Optional filters (see internal/meta)
# E2E_TAGS=smoke,short
# E2E_SKIP_TAGS=long
# E2E_ISSUE=26549
# E2E_RUNTIME=short
