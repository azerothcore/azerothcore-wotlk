VerySlowXpGain.ItemRewards = ""
VerySlowXpGain.ItemRewardAmount = 1
VerySlowXpGain.DisableLevel = 0
VerySlowXpGain.XPMultiplier = 0.25
VerySlowXpGain.AchievementReward = ""

QuestXpOnly.Enable = 1
QuestXpOnly.TitleRewards = ""
