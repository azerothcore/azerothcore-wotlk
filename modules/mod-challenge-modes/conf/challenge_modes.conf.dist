#
# Challenge Modes for AzerothCore 3.3.5a
# Copy to the worldserver config directory or merge into worldserver.conf
#

###################################################################################################
# CHALLENGE MODES
#
#    ChallengeModes.Enable
#        Description: Master switch. If 0, the keeper gossip still opens but cannot start a challenge.
#        Default:     1
#
#    ChallengeModes.FirstLoginUI
#        Description: On first login at level 1 (or 55 DK), open the mode picker (addon + gossip).
#                     Offers every enabled challenge plus Normal mode. 0 = do not auto-open.
#        Default:     1
#
#    ChallengeModes.NPCEntry
#        Description: creature_template.entry of the Keeper of Challenges (must match SQL).
#        Default:     190012
#
#    Modes:
#        Hardcore        - death is permanent (ghost, cannot resurrect)
#        SemiHardcore    - death destroys worn gear and carried gold
#        SelfCrafted     - only self-crafted equipment
#        ItemQualityLevel- Poor / Common gear only
#        SlowXpGain      - 0.5x experience
#        VerySlowXpGain  - 0.25x experience
#        QuestXpOnly     - experience from quests only
#        IronMan         - no resurrect, talents, rare gear, potions, enchants or groups
#
#    Per-mode options, with <M> being Hardcore, SemiHardcore, SelfCrafted,
#    ItemQualityLevel, SlowXpGain, VerySlowXpGain, QuestXpOnly or IronMan:
#        <M>.Enable              (default 1)
#        <M>.XPMultiplier        (default 1, or 0.50 / 0.25 for slow XP)
#        <M>.DisableLevel        (default 0 = never auto-disable)
#        <M>.TitleRewards        ("60 143, 80 145" = level then CharTitles.dbc id)
#        <M>.TalentRewards       ("60 2, 80 5")
#        <M>.ItemRewards         ("80 54811")
#        <M>.ItemRewardAmount    (default 1)
#        <M>.AchievementReward   ("80 1234")
#

ChallengeModes.Enable = 1
ChallengeModes.FirstLoginUI = 1
ChallengeModes.NPCEntry = 190012

Hardcore.Enable = 1
Hardcore.TitleRewards = ""
Hardcore.XPMultiplier = 1
Hardcore.TalentRewards = ""
Hardcore.ItemRewards = ""
Hardcore.ItemRewardAmount = 1
Hardcore.DisableLevel = 0
Hardcore.AchievementReward = ""

SemiHardcore.Enable = 1
SemiHardcore.TitleRewards = ""
SemiHardcore.XPMultiplier = 1
SemiHardcore.TalentRewards = ""
SemiHardcore.ItemRewards = ""
SemiHardcore.ItemRewardAmount = 1
SemiHardcore.DisableLevel = 0
SemiHardcore.AchievementReward = ""

SelfCrafted.Enable = 1
SelfCrafted.TitleRewards = ""
SelfCrafted.XPMultiplier = 1
SelfCrafted.TalentRewards = ""
