#
# Challenge Modes for AzerothCore 3.3.5a
# Copy to the worldserver config directory or merge into worldserver.conf
#

###################################################################################################
# CHALLENGE MODES
#
#    ChallengeModes.Enable
#        Description: Master switch. If 0, the keeper gossip still opens but cannot start a challenge.
#        Default:     1
#
#    ChallengeModes.Announce
#        Description: World-announce when a player accepts a mode, dies in Hardcore / Iron Man,
#                     or completes a challenge at RewardLevel (default 80). 0 = silent.
#        Default:     1
#
#    ChallengeModes.FirstLoginUI
#        Description: On every login at level 1 (or 55 DK), open the mode picker (addon + gossip)
#                     until the character has locked in a challenge. Offers every enabled
#                     challenge plus Normal mode. 0 = do not auto-open.
#        Default:     1
#
#    ChallengeModes.NPCEntry
#        Description: creature_template.entry of the Keeper of Challenges (must match SQL).
#        Default:     190012
#
#    One mode per character
#        A character may enable only ONE challenge. After that, Enable options are hidden
#        and further attempts are rejected. Challenges cannot be turned off (except DisableLevel).
#
#    Modes:
#        Hardcore        - death is permanent (ghost, cannot resurrect); realm announces the fall
#        SemiHardcore    - death destroys worn gear and carried gold
#        SelfCrafted     - only self-crafted equipment
#        ItemQualityLevel- Poor / Common gear only
#        SlowXpGain      - 0.5x experience
#        VerySlowXpGain  - 0.25x experience
#        QuestXpOnly     - experience from quests only
#        IronMan         - no resurrect, talents, rare gear, potions, enchants or groups
#
#    Per-mode options, with <M> being Hardcore, SemiHardcore, SelfCrafted,
#    ItemQualityLevel, SlowXpGain, VerySlowXpGain, QuestXpOnly or IronMan:
#
#        <M>.Enable              (default 1)
#        <M>.XPMultiplier        XP rate (default 1, or 0.50 / 0.25 for slow XP)
#        <M>.GoldRate            gold gained (loot, quests, vendors). Trades stay 1:1.
#        <M>.HonorRate           honor gained (PvP, quests, battlegrounds)
#        <M>.ReputationRate      reputation gained from kills and quests
#        <M>.DisableLevel        (default 0 = never auto-disable)
#
#        Completion rewards at a single target level (default 80). Set the id/amount to 0
#        to skip that reward. Gold is in copper (10000 = 1 gold).
#        <M>.RewardLevel         (default 80)
#        <M>.RewardItem          item entry mailed on completion (0 = none)
#        <M>.RewardItemCount     stack size of RewardItem (default 1)
#        <M>.RewardTitle         CharTitles.dbc id granted when the mode is accepted
#                               and worn as the current title. 0 = no title.
#                               Defaults (stock 3.3.5 titles, visible without a client patch):
#                                 Hardcore         142  the Undying
#                                 SemiHardcore     140  of the Nightfall
#                                 SelfCrafted       85  the Supreme
#                                 ItemQualityLevel 143  Jenkins
#                                 SlowXpGain       172  the Patient
#                                 VerySlowXpGain    78  the Explorer
#                                 QuestXpOnly      125  Loremaster
#                                 IronMan          145  the Insane
#        <M>.RewardGold          copper granted instantly (0 = none)
#        <M>.RewardHonor         honor points (0 = none)
#        <M>.RewardAchievement   achievement id (0 = none)
#        <M>.RewardTalents       extra talent points (0 = none)
#
#        Optional extra rewards at other levels, as "level id, level id":
#        <M>.TitleRewards        ("60 143, 80 145")
#        <M>.TalentRewards       ("60 2, 80 5")
#        <M>.ItemRewards         ("80 54811")
#        <M>.ItemRewardAmount    (default 1) — stack size for ItemRewards
#        <M>.AchievementReward   ("80 1234")
#
#    Examples (commented):
#        Hardcore.RewardLevel = 80
#        Hardcore.RewardTitle = 42
#        Hardcore.RewardItem = 49426
#        Hardcore.RewardItemCount = 5
#        Hardcore.RewardGold = 1000000
#        Hardcore.RewardHonor = 2000
#        Hardcore.GoldRate = 0.5
#        Hardcore.HonorRate = 1.5
#        Hardcore.ReputationRate = 1.25
#        Hardcore.XPMultiplier = 1.25
#

ChallengeModes.Enable = 1
ChallengeModes.Announce = 1
ChallengeModes.FirstLoginUI = 1
ChallengeModes.NPCEntry = 190012

