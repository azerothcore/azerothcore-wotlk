ARG MYSQL_IMAGE=mysql:8.4
###################
# Database Server #
###################

FROM  ${MYSQL_IMAGE} AS dbserver
LABEL description="AzerothCore database"

# explictly define permissions that are  inconsistently in  docker desktop for windows that prevent the file from being read
# harmless on linux
RUN chmod 644 /etc/my.cnf

# binlogging causes unnecessary disk io, ssd wear and consumes lots of disk space over time
# not useful for acore
# disable it
RUN echo "[mysqld]" > /etc/mysql/conf.d/disable_binlog.cnf
RUN echo "skip-log-bin" >> /etc/mysql/conf.d/disable_binlog.cnf
RUN chmod 644 /etc/mysql/conf.d/disable_binlog.cnf
